<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-imap</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley IMAP</name>
	<description>An IMAP server (IMAP4rev2, RFC 9051, also speaking IMAP4rev1) and an IMAP client library
		with a command-line program, built on parley-net and serving the parley-mail store.
		Split out of us.bringardner:bjl_email.</description>
	<inceptionYear>2026</inceptionYear>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.imap</parley.moduleName>
		<junit.version>5.11.4</junit.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>${junit.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<configuration>
						<!-- Small heap on purpose: message bodies must stay out of memory. -->
						<argLine>-Xmx64m</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>

	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-imap</url>
		</repository>
	</distributionManagement>

	<dependencies>
		<!-- Messages and the mail store (MailStore, Mailbox, MailboxConstants) -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-mail</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Server, client, sessions, TLS, authentication -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-net</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>

		<!-- Tests only: TestImapServer checks that IMAP and a POP3 server share the same mail,
		     and the tests reuse TestPop3Server's keystore helper (from the tests jar). -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-pop3</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-pop3</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
