<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>bjl_email</artifactId>
	<name>Bringardner Java Library Email</name>
	<groupId>us.bringardner</groupId>
	<version>1.0.0-SNAPSHOT</version>

	<description>Email message primitives (addresses, headers, RFC 5322 dates) for the BJL Network Framework.</description>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<!-- The oldest Java the code and its bjl_* dependencies (built for Java 11) run on -->
		<maven.compiler.release>11</maven.compiler.release>
		<!-- Branch the GitHub site plugin pushes to on deploy; override with -Dbranch-name=... -->
		<branch-name>V${project.version}</branch-name>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>3.13.0</version>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-source-plugin</artifactId>
					<version>3.3.1</version>
					<executions>
						<execution>
							<id>attach-sources</id>
							<goals>
								<goal>jar-no-fork</goal>
							</goals>
							<phase>package</phase>							
							<configuration>
								<skipSource>false</skipSource>
								<attach>true</attach>
							</configuration>
						</execution>
					</executions>
				</plugin>
				<plugin>
					<artifactId>maven-deploy-plugin</artifactId>
					<version>2.8.2</version>
				</plugin>
				<plugin>
					<groupId>com.github.github</groupId>
					<artifactId>site-maven-plugin</artifactId>
					<version>0.12</version>
					<configuration>
						<message>Maven artifacts for ${project.version}</message>
						<noJekyll>true</noJekyll>
						<outputDirectory>${project.build.directory}</outputDirectory>
						<branch>refs/heads/${branch-name}</branch>
						<includes>
							<include>**/*</include>
						</includes>
						<merge>true</merge>
						<repositoryName>BjlEmail</repositoryName>
						<repositoryOwner>tony-bringardner</repositoryOwner>
						<server>github</server>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>site</goal>
							</goals>
							<phase>deploy</phase>
						</execution>
					</executions>
				</plugin>

				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-surefire-plugin</artifactId>
					<version>3.5.2</version>
					<configuration>
						<!-- Small heap on purpose: TestLargeMessage handles a 150 MB attachment,
						     which only passes if Message keeps bodies out of memory. -->
						<argLine>-Xmx64m</argLine>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>

		<!-- Versions and configuration come from pluginManagement above;
		     listing them here is what makes their executions run. -->
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>com.github.github</groupId>
				<artifactId>site-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/BjlEmail</url>
		</repository>

	</distributionManagement>

	<url>http://bringardner.us/BJL/BjlEmail</url>
	<inceptionYear>2026</inceptionYear>

	<dependencies>
		<dependency>
  			<groupId>us.bringardner</groupId>
  			<artifactId>bjl_net_framework</artifactId>
  			<version>1.0.2-SNAPSHOT</version>
		</dependency>
		<dependency>
  			<groupId>us.bringardner</groupId>
  			<artifactId>bjl_file_system</artifactId>
  			<version>1.0.2-SNAPSHOT</version>
		</dependency>
		<!-- DNS client for BjlDnsMxResolver (MX lookups for the SMTP queue) and DKIM key lookups.
		     1.0.1 adds the typed Lookup API.
		     bjl_core and bjl_io come from the framework instead of its older versions. -->
		<dependency>
  			<groupId>us.bringardner</groupId>
  			<artifactId>bjl_dns</artifactId>
  			<version>1.0.1-SNAPSHOT</version>
  			<exclusions>
  				<exclusion>
  					<groupId>us.bringardner</groupId>
  					<artifactId>bjl_core</artifactId>
  				</exclusion>
  				<exclusion>
  					<groupId>us.bringardner</groupId>
  					<artifactId>bjl_io</artifactId>
  				</exclusion>
  			</exclusions>
		</dependency>

		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<version>5.9.1</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite-engine</artifactId>
			<version>1.9.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
